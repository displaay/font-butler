{
  "name": "fontcase",
  "productName": "Fontcase",
  "private": true,
  "version": "0.1.0",
  "description": "Source-tracked font manager for macOS",
  "author": "Fontcase",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -n server,vite -c cyan,magenta \"npm run server\" \"vite\"",
    "server": "tsx server/index.ts",
    "electron": "concurrently -k -n server,vite,app -c cyan,magenta,green \"npm run server\" \"vite\" \"wait-on http://127.0.0.1:43181 && electron .\"",
    "build": "tsc -b && vite build",
    "dist": "npm run build && electron-builder --mac",
    "preview": "vite preview --host 127.0.0.1 --port 43181",
    "lint": "oxlint"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fontkit": "^2.0.4",
    "hono": "^4.11.3",
    "lucide-react": "^0.544.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/fontkit": "^2.0.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "app.fontcase.desktop",
    "productName": "Fontcase",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "core/**/*",
      "server/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "fileAssociations": [
      {
        "ext": "ttf",
        "name": "TrueType Font",
        "role": "Editor",
        "description": "TrueType font"
      },
      {
        "ext": "otf",
        "name": "OpenType Font",
        "role": "Editor",
        "description": "OpenType font"
      },
      {
        "ext": "ttc",
        "name": "TrueType Collection",
        "role": "Editor",
        "description": "TrueType font collection"
      },
      {
        "ext": "otc",
        "name": "OpenType Collection",
        "role": "Editor",
        "description": "OpenType font collection"
      },
      {
        "ext": "woff",
        "name": "WOFF Font",
        "role": "Editor",
        "description": "Web Open Font Format"
      },
      {
        "ext": "woff2",
        "name": "WOFF2 Font",
        "role": "Editor",
        "description": "Web Open Font Format 2"
      }
    ]
  }
}
