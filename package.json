{
  "name": "font-butler",
  "productName": "Font Buttler",
  "private": true,
  "version": "0.3.3",
  "description": "Source-tracked font manager for macOS",
  "author": "Font Buttler",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -n server,vite -c cyan,magenta \"npm run server\" \"vite\"",
    "server": "FONT_BUTLER_DEV_BOOTSTRAP=1 tsx server/index.ts",
    "electron": "concurrently -k -n server,vite,app -c cyan,magenta,green \"npm run server\" \"vite\" \"wait-on http://127.0.0.1:43181 http-get://127.0.0.1:43182/api/health && electron .\"",
    "build": "tsc -b && vite build && node scripts/bundle-server.mjs",
    "bundle:python": "COPYFILE_DISABLE=1 node scripts/bundle-python-runtime.mjs",
    "dist": "COPYFILE_DISABLE=1 npm run build && npm run bundle:python && node scripts/build-finder-services.mjs && node scripts/build-session-fonts.mjs && COPYFILE_DISABLE=1 electron-builder --mac --publish never",
    "preview": "vite preview --host 127.0.0.1 --port 43181",
    "lint": "oxlint",
    "test": "FONT_BUTLER_TEST=1 tsx --test --test-concurrency=1 core/**/*.test.ts src/**/*.test.ts electron/**/*.test.mjs",
    "test:native": "FONT_BUTLER_TEST=1 FONT_BUTLER_NATIVE=1 tsx --test --test-concurrency=1 core/native.integration.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@hono/node-server": "^1.19.9",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "@types/fontkit": "^2.0.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.0.12",
    "fontkit": "^2.0.4",
    "hono": "^4.11.3",
    "lucide-react": "^0.544.0",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "app.fontbutler.desktop",
    "productName": "Font Buttler",
    "electronLanguages": [
      "en"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.mjs",
      "!electron/**/*.mm",
      "build/icon.png",
      "build/menubarTemplate.png",
      "build/menubarTemplate@2x.png",
      "build/menubarNotificationTemplate.svg",
      "build/icons/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/python",
        "to": "python",
        "filter": [
          "**/*",
          "!**/__pycache__",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "afterPack": "./scripts/strip-mac-xattrs.mjs",
    "afterAllArtifactBuild": "./scripts/strip-mac-xattrs.mjs",
    "directories": {
      "output": "release"
    },
    "artifactName": "Font-Buttler-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "displaay",
      "repo": "font-butler",
      "releaseType": "release"
    },
    "mac": {
      "identity": "-",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSUserNotificationsUsageDescription": "Font Buttler can notify you when fonts are installed or updated.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Font Buttler Finder Install",
            "CFBundleURLSchemes": [
              "font-butler"
            ]
          }
        ],
        "NSServices": [
          {
            "NSMenuItem": {
              "default": "Install"
            },
            "NSMessage": "installFonts",
            "NSPortName": "Font Buttler",
            "NSUserData": "install",
            "NSRequiredContext": {
              "NSTextContent": "FilePath"
            },
            "NSSendFileTypes": [
              "public.font",
              "public.opentype-font",
              "public.truetype-ttf-font",
              "public.truetype-collection-font"
            ]
          },
          {
            "NSMenuItem": {
              "default": "Install as…"
            },
            "NSMessage": "installFontsAs",
            "NSPortName": "Font Buttler",
            "NSUserData": "install-as",
            "NSRequiredContext": {
              "NSTextContent": "FilePath"
            },
            "NSSendFileTypes": [
              "public.font",
              "public.opentype-font",
              "public.truetype-ttf-font",
              "public.truetype-collection-font"
            ]
          },
          {
            "NSMenuItem": {
              "default": "Link to …"
            },
            "NSMessage": "linkFonts",
            "NSPortName": "Font Buttler",
            "NSUserData": "link-to",
            "NSRequiredContext": {
              "NSTextContent": "FilePath"
            },
            "NSSendFileTypes": [
              "public.font",
              "public.opentype-font",
              "public.truetype-ttf-font",
              "public.truetype-collection-font"
            ]
          }
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "TrueType Font",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "public.truetype-ttf-font"
            ],
            "CFBundleTypeIconFile": "finderDocIcon.icns"
          },
          {
            "CFBundleTypeName": "OpenType Font",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "public.opentype-font"
            ],
            "CFBundleTypeIconFile": "finderDocIcon.icns"
          }
        ]
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "fileAssociations": [
      {
        "ext": "ttf",
        "name": "TrueType Font",
        "role": "Editor",
        "description": "TrueType font",
        "icon": "finderDocIcon"
      },
      {
        "ext": "otf",
        "name": "OpenType Font",
        "role": "Editor",
        "description": "OpenType font",
        "icon": "finderDocIcon"
      },
      {
        "ext": "ttc",
        "name": "TrueType Collection",
        "role": "Editor",
        "description": "TrueType font collection",
        "icon": "finderDocIcon"
      },
      {
        "ext": "otc",
        "name": "OpenType Collection",
        "role": "Editor",
        "description": "OpenType font collection",
        "icon": "finderDocIcon"
      },
      {
        "ext": "woff",
        "name": "WOFF Font",
        "role": "Editor",
        "description": "Web Open Font Format",
        "icon": "finderDocIcon"
      },
      {
        "ext": "woff2",
        "name": "WOFF2 Font",
        "role": "Editor",
        "description": "Web Open Font Format 2",
        "icon": "finderDocIcon"
      }
    ]
  }
}
