{
  "name": "font-butler",
  "productName": "Font Buttler",
  "private": true,
  "version": "0.1.1",
  "description": "Source-tracked font manager for macOS",
  "author": "Font Buttler",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -n server,vite -c cyan,magenta \"npm run server\" \"vite\"",
    "server": "FONT_BUTLER_DEV_BOOTSTRAP=1 tsx server/index.ts",
    "electron": "concurrently -k -n server,vite,app -c cyan,magenta,green \"npm run server\" \"vite\" \"wait-on http://127.0.0.1:43181 && electron .\"",
    "build": "tsc -b && vite build && node scripts/bundle-server.mjs",
    "bundle:python": "node scripts/bundle-python-runtime.mjs",
    "dist": "npm run build && npm run bundle:python && electron-builder --mac",
    "preview": "vite preview --host 127.0.0.1 --port 43181",
    "lint": "oxlint",
    "test": "FONT_BUTLER_TEST=1 tsx --test --test-concurrency=1 core/**/*.test.ts src/**/*.test.ts electron/**/*.test.mjs",
    "test:native": "FONT_BUTLER_TEST=1 FONT_BUTLER_NATIVE=1 tsx --test --test-concurrency=1 core/native.integration.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fontkit": "^2.0.4",
    "hono": "^4.11.3",
    "lucide-react": "^0.544.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/fontkit": "^2.0.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "app.fontbutler.desktop",
    "productName": "Font Buttler",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "core/**/*",
      "server/**/*",
      "scripts/**/*",
      "build/icon.png",
      "build/menubarTemplate.png",
      "build/menubarTemplate@2x.png",
      "build/menubarNotificationTemplate.svg",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/python",
        "to": "python"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSUserNotificationsUsageDescription": "Font Buttler can notify you when fonts are installed or updated.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "TrueType Font",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": ["public.truetype-ttf-font"],
            "CFBundleTypeIconFile": "finderDocIcon.icns"
          },
          {
            "CFBundleTypeName": "OpenType Font",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": ["public.opentype-font"],
            "CFBundleTypeIconFile": "finderDocIcon.icns"
          }
        ]
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "fileAssociations": [
      {
        "ext": "ttf",
        "name": "TrueType Font",
        "role": "Editor",
        "description": "TrueType font",
        "icon": "finderDocIcon"
      },
      {
        "ext": "otf",
        "name": "OpenType Font",
        "role": "Editor",
        "description": "OpenType font",
        "icon": "finderDocIcon"
      },
      {
        "ext": "ttc",
        "name": "TrueType Collection",
        "role": "Editor",
        "description": "TrueType font collection",
        "icon": "finderDocIcon"
      },
      {
        "ext": "otc",
        "name": "OpenType Collection",
        "role": "Editor",
        "description": "OpenType font collection",
        "icon": "finderDocIcon"
      },
      {
        "ext": "woff",
        "name": "WOFF Font",
        "role": "Editor",
        "description": "Web Open Font Format",
        "icon": "finderDocIcon"
      },
      {
        "ext": "woff2",
        "name": "WOFF2 Font",
        "role": "Editor",
        "description": "Web Open Font Format 2",
        "icon": "finderDocIcon"
      }
    ]
  }
}
