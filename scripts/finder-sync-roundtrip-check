#!/usr/bin/env node
/**
 * After a signed macOS build, register the Finder Sync LaunchAgent from the
 * app, ping the launchd-vended Mach service, and confirm an ad-hoc client is
 * rejected.
 *
 *   scripts/finder-sync-roundtrip-check [/path/to/Font Buttler.app]
 *
 * The positive client is signed with Developer ID and the appex identifier,
 * which is the listener's code-signing requirement. The negative client is
 * ad-hoc signed with that same identifier and must not reach ping.
 * Off macOS this prints a skip line and exits 0.
 */
import { spawnSync } from 'node:child_process'
import { existsSync, mkdtempSync, rmSync } from 'node:fs'
import { tmpdir } from 'node:os'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { readAppTestFeedMarker } from '../electron/app-update-install.mjs'
import { finderSyncBundleId, finderSyncMachService } from '../electron/finder-sync.mjs'
import { DEVELOPER_ID_IDENTITY } from './mac-signing.mjs'

const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
const clientSource = path.join(repoRoot, 'macos/FinderSyncAgent/FinderSyncPingClient.mm')

function fail(message) {
  console.error(message)
  process.exit(1)
}

function findApp(argument) {
  if (argument) return path.resolve(argument)
  const names = ['mac-arm64', 'mac', 'mac-x64']
  for (const root of ['dist', 'release']) {
    for (const name of names) {
      const candidate = path.join(repoRoot, root, name, 'Font Buttler.app')
      if (existsSync(candidate)) return candidate
    }
  }
  return ''
}

function developerId() {
  const listed = spawnSync('security', ['find-identity', '-v', '-p', 'codesigning'], { encoding: 'utf8' })
  const identity = `Developer ID Application: ${DEVELOPER_ID_IDENTITY}`
  const output = `${listed.stdout ?? ''}\n${listed.stderr ?? ''}`
  if (!output.includes(identity)) {
    fail(`No codesigning identity "${identity}" in the login keychain.`)
  }
  return identity
}

function run(command, args, options = {}) {
  return spawnSync(command, args, { encoding: 'utf8', ...options })
}

function main() {
  if (process.platform !== 'darwin') {
    console.log('skipped: Finder Sync roundtrip runs on macOS after a signed build')
    process.exit(0)
  }
  const app = findApp(process.argv[2])
  if (!app) fail('Pass the path to a signed Font Buttler.app.')
  const testFeed = readAppTestFeedMarker(app) === true
  const service = finderSyncMachService(testFeed)
  const appexId = finderSyncBundleId(testFeed)
  const binary = path.join(app, 'Contents', 'MacOS', 'Font Buttler')
  console.log(`app: ${app}`)
  console.log(`flavour: ${testFeed ? 'test' : 'release'}`)
  console.log(`service: ${service}`)
  const status = run(binary, ['--finder-sync-agent-status'], { timeout: 60000 })
  const output = `${status.stdout ?? ''}\n${status.stderr ?? ''}`
  const line = output
    .split(/\r?\n/)
    .map((item) => item.trim())
    .find((item) => item.startsWith('finder-sync-agent-status '))
  console.log(line || output.trim() || `finder-sync-agent-status unavailable (exit ${status.status})`)
  if (!line) fail('The app did not print a Finder Sync agent status.')
  let parsed
  try {
    parsed = JSON.parse(line.slice('finder-sync-agent-status '.length))
  } catch {
    fail('The agent status line was not JSON.')
  }
  if (parsed.status !== 'enabled') {
    fail(
      parsed.status === 'requires-approval'
        ? 'Approve Font Buttler under System Settings → General → Login Items & Extensions, then run this again.'
        : `Finder Sync agent status is ${parsed.status}${parsed.error ? `: ${parsed.error}` : ''}.`,
    )
  }

  const identity = developerId()
  const temp = mkdtempSync(path.join(tmpdir(), 'font-butler-finder-sync-'))
  const positive = path.join(temp, 'ping-positive')
  const negative = path.join(temp, 'ping-negative')
  try {
    const clang = process.env.FONT_BUTLER_CLANG || 'clang++'
    const compiled = run(clang, [
      '-std=c++17',
      '-ObjC++',
      '-fobjc-arc',
      '-mmacosx-version-min=11.0',
      '-framework',
      'Cocoa',
      '-o',
      positive,
      clientSource,
    ])
    if (compiled.status !== 0) {
      fail(compiled.stderr || compiled.stdout || 'Could not compile the ping client.')
    }
    run('cp', [positive, negative])
    const signed = run('codesign', [
      '--force',
      '--sign',
      identity,
      '--identifier',
      appexId,
      '--options',
      'runtime',
      positive,
    ])
    if (signed.status !== 0) fail(signed.stderr || 'Could not sign the positive ping client.')
    const adhoc = run('codesign', ['--force', '--sign', '-', '--identifier', appexId, negative])
    if (adhoc.status !== 0) fail(adhoc.stderr || 'Could not ad-hoc sign the negative ping client.')
    const positiveDisplay = run('codesign', ['-dv', '--verbose=4', positive])
    const positiveText = `${positiveDisplay.stdout ?? ''}\n${positiveDisplay.stderr ?? ''}`
    if (!positiveText.includes(`Identifier=${appexId}`) || !positiveText.includes('Developer ID Application')) {
      fail('The positive client is not Developer ID signed as the Finder Sync appex.')
    }
    const negativeDisplay = run('codesign', ['-dv', '--verbose=4', negative])
    const negativeText = `${negativeDisplay.stdout ?? ''}\n${negativeDisplay.stderr ?? ''}`
    if (!/Signature=adhoc/i.test(negativeText)) fail('The negative client is not ad-hoc signed.')

    const ping = run(positive, [service], { timeout: 20000 })
    const pingText = `${ping.stdout ?? ''}\n${ping.stderr ?? ''}`
    console.log(`positive: ${pingText.trim() || `exit ${ping.status}`}`)
    if (ping.status !== 0 || !ping.stdout?.includes('ping ok')) {
      fail('The Developer ID client did not receive a ping reply.')
    }
    const rejected = run(negative, [service], { timeout: 20000 })
    const rejectedText = `${rejected.stdout ?? ''}\n${rejected.stderr ?? ''}`
    console.log(`negative: ${rejectedText.trim() || `exit ${rejected.status}`}`)
    if (rejected.stdout?.includes('ping ok') || !rejectedText.includes('rejected')) {
      fail('The ad-hoc client was not rejected.')
    }
    console.log('roundtrip: ok')
  } finally {
    rmSync(temp, { recursive: true, force: true })
  }
}

const invokedDirectly = process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)
if (invokedDirectly) main()
